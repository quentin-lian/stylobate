{
  "name": "@stylobate/i18n",
  "version": "0.1.0",
  "description": "国际化方案：基于 i18next 的薄封装，React/Vue 双框架绑定，翻译 key 提取脚本。",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "import": "./dist/extract/index.js"
    }
  },
  "bin": {
    "stylobate-i18n-extract": "./dist/extract/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.react.json && tsc -p tsconfig.vue.json && tsc -p tsconfig.extract.json",
    "dev": "tsc -p tsconfig.react.json --watch",
    "lint": "eslint --max-warnings 0 src",
    "check-types": "tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.vue.json --noEmit && tsc -p tsconfig.extract.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "i18next": "^25"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-i18next": "^15",
    "vue": "^3.3",
    "vue-i18n": "^11"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stylobate/eslint-config": "workspace:*",
    "@stylobate/test-config": "workspace:*",
    "@stylobate/typescript-config": "workspace:*",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "eslint": "^9.39.1",
    "jsdom": "^29",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^15",
    "typescript": "5.9.2",
    "vitest": "^4",
    "vue": "^3.5",
    "vue-i18n": "^11"
  },
  "publishConfig": {
    "access": "public"
  }
}
